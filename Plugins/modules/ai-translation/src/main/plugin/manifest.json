{
  "id": "hyperlyric.ai.translation",
  "name": "OpenAI 翻译",
  "nameLocales": {
    "en": "OpenAI Translation",
    "ar": "ترجمة OpenAI"
  },
  "author": "lidesheng",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "com.lidesheng.hyperlyric.plugin.ai.translation.AiTranslationPlugin",
  "activationSettingKey": "enabled",
  "settingGroups": [
    {
      "id": "default",
      "title": "基础设置",
      "titleLocales": {
        "en": "Basic Settings",
        "ar": "الإعدادات الأساسية"
      }
    },
    {
      "id": "generation",
      "title": "高级设置",
      "titleLocales": {
        "en": "Advanced Settings",
        "ar": "الإعدادات المتقدمة"
      }
    }
  ],
  "cacheScopes": [
    {
      "id": "translation",
      "title": "翻译缓存",
      "summary": "清理 AI 翻译结果缓存",
      "titleLocales": {
        "en": "Translation Cache"
      },
      "summaryLocales": {
        "en": "Clear cached AI translation results"
      }
    }
  ],
  "settings": [
    {
      "type": "switch",
      "key": "enabled",
      "title": "OpenAI 翻译",
      "titleLocales": {
        "en": "OpenAI Translation",
        "ar": "ترجمة OpenAI"
      },
      "default": false
    },
    {
      "type": "multiSelect",
      "key": "skip_languages",
      "title": "自动跳过语言",
      "titleLocales": {
        "en": "Automatically Skip Languages",
        "ar": "تخطي اللغات تلقائيًا"
      },
      "dialogSummary": "勾选后，识别为这些语言的歌词将不会请求 AI 翻译",
      "dialogSummaryLocales": {
        "en": "Lyrics detected as selected languages will not be sent for AI translation",
        "ar": "الكلمات اللي بتتكشف باللغات المختارة مش هترسل للترجمة بالذكاء الاصطناعي"
      },
      "emptyValueSummary": "未选择（关闭）",
      "emptyValueSummaryLocales": {
        "en": "None (off)",
        "ar": "بدون (معطّل)"
      },
      "default": "",
      "options": [
        { "value": "zh", "label": "中文" },
        { "value": "en", "label": "English" },
        { "value": "ja", "label": "日本語" },
        { "value": "ko", "label": "한국어" },
        { "value": "es", "label": "Español" }
      ]
    },
    {
      "type": "switch",
      "key": "skip_existing",
      "title": "自动跳过已有翻译歌曲",
      "titleLocales": {
        "en": "Auto Skip Songs with Translation",
        "ar": "تخطي الأغاني اللي عندها ترجمة تلقائيًا"
      },
      "default": false,
      "conflictsWith": ["force_override"]
    },
    {
      "type": "switch",
      "key": "force_override",
      "title": "强制 AI 翻译",
      "titleLocales": {
        "en": "Force AI Translation",
        "ar": "فرض الترجمة بالذكاء الاصطناعي"
      },
      "default": false,
      "conflictsWith": ["skip_existing"]
    },
    {
      "type": "text",
      "key": "target_language",
      "title": "目标语言",
      "titleLocales": {
        "en": "Target Language",
        "ar": "اللغة المستهدفة"
      },
      "default": "中文",
      "valuePresentation": "endAction"
    },
    {
      "type": "password",
      "key": "api_key",
      "title": "API Key",
      "titleLocales": {
        "en": "API Key",
        "ar": "مفتاح API"
      },
      "default": "",
      "emptyValueSummary": "未配置",
      "emptyValueSummaryLocales": {
        "en": "Not configured",
        "ar": "غير مُعدّ"
      },
      "valuePresentation": "endAction",
      "backup": false
    },
    {
      "type": "text",
      "key": "model",
      "title": "模型名称",
      "titleLocales": {
        "en": "Model Name",
        "ar": "اسم النموذج"
      },
      "default": "mimo-v2.5",
      "valuePresentation": "endAction"
    },
    {
      "type": "text",
      "key": "base_url",
      "title": "OpenAI API 地址",
      "titleLocales": {
        "en": "API Base URL",
        "ar": "رابط API الأساسي"
      },
      "default": "https://api.xiaomimimo.com/v1/",
      "valuePresentation": "summary",
      "inputType": "uri"
    },
    {
      "type": "text",
      "key": "prompt",
      "title": "自定义提示词",
      "titleLocales": {
        "en": "Custom Prompt",
        "ar": "موجّه مخصص"
      },
      "default": "你是一个歌词翻译专家，遵循\"信雅达\"原则进行创作。\n\n## 核心：信雅达 (Cultural Transcreation)\n- 信/灵魂对位：深度理解原文背景与世界观。严禁句式套用，必须打破语序，以目标语言的意向逻辑重塑内核，确保\"神不散\"。\n- 雅/审美重构：捕获隐喻，拒绝平铺直叙。根据曲风炼字，民谣讲究留白意境，摇滚追求文化冲击。\n- 达/呼吸转译：彻底消除翻译腔。译文须契合旋律起伏与呼吸断句，确保副歌具备跨文化的传播记忆点。\n\n## 深度适配要求\n- 隐喻重映射：将原文的文化隐喻转化为目标受众能理解的对等词。允许逻辑倒置，用画面感取代生硬解释。\n- 背景融入：保留特定的世界观语域。译文需符合原曲设定的时空感、社会身份或情感底色。\n\n## 节奏与技术\n- 等时对齐：音节/字数必须严丝合缝适配节拍，严禁在短拍堆砌文字。\n- 动态押韵：除 Rap/特定流行强求押韵外，优先保证情绪流转自然。严禁为押韵损毁隐喻或文化美感。\n- 解构再造：拆碎原文逻辑，以母语者直觉进行\"意象创作\"，使译文像原创作品般自然。",
      "valuePresentation": "summaryPreview",
      "previewLineCount": 2
    },
    {
      "type": "slider",
      "key": "temperature",
      "title": "temperature",
      "dialogSummary": "Input range: 0–2.",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.1,
      "inputType": "number",
      "group": "generation"
    },
    {
      "type": "slider",
      "key": "top_p",
      "title": "top_p",
      "dialogSummary": "Input range: 0–1.",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "inputType": "number",
      "group": "generation"
    },
    {
      "type": "number",
      "key": "max_tokens",
      "title": "max_tokens",
      "dialogSummary": "Input range: 0–2147483647.",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "inputType": "number",
      "valuePresentation": "endAction",
      "group": "generation"
    }
  ]
}
